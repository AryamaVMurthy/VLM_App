# Android/Gradle build outputs
android-app/.gradle/
android-app/**/build/
android-app/whisperlib/.cxx/
.gradle/
.idea/
*.iml
local.properties

# Local artifacts and debug dumps
/artifacts/*
!/artifacts/README.md
!/artifacts/graphpilot_edge/
/artifacts/graphpilot_edge/*
!/artifacts/graphpilot_edge/README.md
*.log
*.tmp
*.xml

# Packaged binaries
*.apk
*.aab
*.ap_

# Local model payloads (downloaded on-device/host, not source-controlled)
*.litertlm
artifacts/models/

# Nested third-party repository metadata snapshots
**/.git.hidden/
third_party/litert/artifacts/

# Keep published installable artifacts in-repo
!apk/
!apk/*.apk
!apk/*.sha256

# Local developer environments
.venv/
tmp/
__pycache__/
